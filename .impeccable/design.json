      "css": ".ds-segments{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:inline-flex;padding:3px;border:1px solid #cddace;border-radius:6px;background:#f0f4ed;gap:2px;}.ds-segment{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;border:0;background:transparent;padding:7px 10px;font-size:11px;font-weight:550;line-height:1.25;border-radius:4px;color:#53705d;cursor:pointer;}.ds-segment.ds-segment-active{background:var(--surface,#fff);color:#204b43;box-shadow:0 1px 3px #21483814;}.ds-segment:hover{background:#dfeadd;}.ds-segment:focus-visible{outline:3px solid #73a99b;outline-offset:3px;}@media(max-width:600px){.ds-segment{padding:7px 8px;font-size:10px;}}"
    },
    {
      "name": "Dimension and Evidence Field",
      "kind": "custom",
      "refersTo": "dimension-number",
      "description": "Actual compact numeric field, unit wrapper and evidence select. Numeric example is provisional.",
      "html": "<div class=\"ds-dimension\"><label class=\"ds-dimension-label\" for=\"ds-diameter\">Internal diameter</label><div class=\"ds-number\"><input class=\"ds-number-input\" id=\"ds-diameter\" type=\"number\" value=\"70\" min=\"30\" max=\"200\" step=\"1\"/><span class=\"ds-number-unit\">mm</span></div><select class=\"ds-basis\" aria-label=\"Internal diameter evidence status\"><option>Provisional</option><option>Source-reported</option><option>Measured by you</option></select></div>",
      "css": ".ds-dimension{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:grid;grid-template-columns:1fr 93px;gap:5px 9px;align-items:center;margin-bottom:13px;color:var(--ink,#233e3b);}.ds-dimension-label{font-size:11px;line-height:1.45;}.ds-number{display:flex;align-items:center;border:1px solid #c8d6cb;border-radius:5px;overflow:hidden;background:#fbfdf8;}.ds-number-input{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;width:62px;min-width:0;border:0;background:transparent;color:var(--ink,#233e3b);padding:7px 6px;font-size:12px;appearance:textfield;text-align:right;font-variant-numeric:tabular-nums;caret-color:var(--teal,#286f6a);}.ds-number-input::-webkit-inner-spin-button{appearance:none;}.ds-number-input:focus-visible{outline:3px solid #73a99b;outline-offset:-3px;}.ds-number-unit{font-size:10px;color:#536f5b;margin-left:3px;}.ds-basis{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;grid-column:1/-1;justify-self:start;border:0;padding:0 13px 0 0;font-size:9px;height:16px;border-radius:0;background:transparent;color:#836528;max-width:125px;}.ds-basis:focus-visible{outline:3px solid #73a99b;outline-offset:3px;}.ds-basis.ds-basis-measured{color:#316951;}.ds-basis.ds-basis-reported{color:#526f75;}"
    },
    {
      "name": "Notebook Readings Table",
