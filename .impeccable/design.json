    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Forest action for beginning an experiment or saving a reading.",
      "html": "<button class=\"ds-primary\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5v14\"/></svg>Start an experiment</button>",
      "css": ".ds-primary{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:var(--radius,6px);padding:9px 13px;font-size:14px;font-weight:550;line-height:1.25;cursor:pointer;text-decoration:none;background:var(--forest,#173d3c);color:var(--surface,#fff);border:1px solid var(--forest,#173d3c);}.ds-primary:hover{background:#245653;border-color:#245653;}.ds-primary:focus-visible{outline:3px solid #73a99b;outline-offset:3px;}.ds-primary:disabled{opacity:.55;cursor:not-allowed;}"
    },
    {
