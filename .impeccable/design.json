    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Compact viewer action with selected state and an explicit accessible name.",
      "html": "<button class=\"ds-icon ds-icon-selected\" aria-label=\"Toggle dimension labels\" aria-pressed=\"true\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m21.3 8.7-6-6a1 1 0 0 0-1.4 0L2.7 13.9a1 1 0 0 0 0 1.4l6 6a1 1 0 0 0 1.4 0L21.3 10.1a1 1 0 0 0 0-1.4Z\"/><path d=\"m7.5 10.5 2 2m1-5 2 2m1-5 2 2m-11 7 2 2\"/></svg></button>",
      "css": ".ds-icon{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:inline-flex;align-items:center;justify-content:center;border:1px solid transparent;border-radius:var(--radius,6px);background:transparent;color:#62806d;padding:7px;cursor:pointer;}.ds-icon.ds-icon-selected{background:#e0eadc;color:#275d4f;border-color:#d0dfc9;}.ds-icon:hover{background:#edf2ec;border-color:#99b2a5;}.ds-icon.ds-icon-selected:hover{background:#e0eadc;border-color:#d0dfc9;}.ds-icon:focus-visible{outline:3px solid #73a99b;outline-offset:3px;}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Label, white field, placeholder and supporting text, using native input behavior.",
      "html": "<label class=\"ds-field\">Condition / sample ID<input class=\"ds-field-input\" placeholder=\"e.g. baseline · unit A\"/><small class=\"ds-field-help\">Reuse the same ID for a continuous series.</small></label>",
      "css": ".ds-field{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:flex;flex-direction:column;gap:7px;font-size:11px;color:#425f50;}.ds-field-input{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;color:var(--ink,#233e3b);background:var(--surface,#fff);border:1px solid #b9cac0;border-radius:5px;padding:9px 10px;min-width:0;font-size:12px;caret-color:var(--teal,#286f6a);}.ds-field-input::placeholder{color:#657b71;}.ds-field-input:focus-visible{outline:3px solid #73a99b;outline-offset:3px;}.ds-field-help{color:var(--muted,#536d67);font-size:11px;line-height:1.5;}"
    },
    {
      "name": "Workbench Navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Global filled selection against forest; labels return in the small-screen top band.",
      "html": "<nav class=\"ds-navigation\" aria-label=\"Workbench\"><button class=\"ds-nav-item ds-nav-active\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z\"/><path d=\"m3.3 7 8.7 5 8.7-5M12 22V12\"/></svg><span class=\"ds-nav-label\">Reactor</span></button><button class=\"ds-nav-item\"><span class=\"ds-nav-label\">Notebook</span></button></nav>",
      "css": ".ds-navigation{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:grid;gap:6px;background:var(--forest,#173d3c);padding:18px;width:174px;}.ds-nav-item{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:inline-flex;align-items:center;justify-content:flex-start;gap:8px;border:none;border-radius:5px;background:transparent;color:#c2d8ce;padding:12px 13px;font-size:13px;font-weight:500;line-height:1.25;cursor:pointer;}.ds-nav-item:hover{background:#254e49;color:#fff;}.ds-nav-item.ds-nav-active{background:#d4e6d5;color:var(--forest,#173d3c);font-weight:650;}.ds-nav-item:focus-visible{outline:3px solid #73a99b;outline-offset:3px;}@media(max-width:1200px) and (min-width:601px){.ds-navigation{width:48px;padding:12px;}.ds-nav-item{justify-content:center;padding:13px;}.ds-nav-label{display:none;}}@media(max-width:600px){.ds-navigation{display:flex;width:auto;gap:2px;padding:14px 17px 0;}.ds-nav-item{flex:1;font-size:10px;gap:6px;padding:12px 4px;border-radius:4px 4px 0 0;}.ds-nav-label{display:block;}}"
